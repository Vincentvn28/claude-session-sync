{
  "name": "claude-session-sync",
  "displayName": "Claude Session Sync",
  "description": "Đồng bộ Claude Code session (chat history + memory + plans) giữa các máy qua Google Drive — 1 click push/pull, mã hoá AES-256.",
  "version": "0.3.0",
  "publisher": "Claudesessionsync",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": ["claude", "claude code", "antigravity", "sync", "session"],
  "icon": "media/logo.png",
  "license": "MIT",
  "homepage": "https://github.com/Vincentvn28/claude-session-sync#readme",
  "bugs": {
    "url": "https://github.com/Vincentvn28/claude-session-sync/issues"
  },
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeSync.push",
        "title": "Claude Sync: Push session lên Google Drive (mỗi session 1 file)",
        "category": "Claude Sync"
      },
      {
        "command": "claudeSync.pull",
        "title": "Claude Sync: Pull session từ Google Drive (chọn nhiều)",
        "category": "Claude Sync"
      },
      {
        "command": "claudeSync.signIn",
        "title": "Claude Sync: Đăng nhập Google",
        "category": "Claude Sync"
      },
      {
        "command": "claudeSync.signOut",
        "title": "Claude Sync: Đăng xuất Google",
        "category": "Claude Sync"
      },
      {
        "command": "claudeSync.setPassphrase",
        "title": "Claude Sync: Đặt / đổi passphrase mã hoá",
        "category": "Claude Sync"
      },
      {
        "command": "claudeSync.openDriveFolder",
        "title": "Claude Sync: Mở folder Drive trong browser",
        "category": "Claude Sync"
      },
      {
        "command": "claudeSync.showMenu",
        "title": "Claude Sync: Hiện menu",
        "category": "Claude Sync"
      }
    ],
    "configuration": {
      "title": "Claude Session Sync",
      "properties": {
        "claudeSync.driveFolderName": {
          "type": "string",
          "default": "ClaudeCodeSync",
          "description": "Tên folder gốc trên Google Drive để lưu session."
        },
        "claudeSync.includeSettings": {
          "type": "boolean",
          "default": false,
          "description": "Có bao gồm settings.json của Claude (chứa hooks/keys) trong file đẩy lên không. Mặc định: tắt."
        },
        "claudeSync.autoPushOnExit": {
          "type": "boolean",
          "default": false,
          "description": "Tự động push session khi đóng cửa sổ. Lưu ý: làm chậm thao tác đóng app."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18 --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18 --sourcemap --watch",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/node": "^20.11.0",
    "@types/unzipper": "^0.10.10",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "archiver": "^6.0.2",
    "unzipper": "^0.10.14"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Vincentvn28/claude-session-sync.git"
  }
}
